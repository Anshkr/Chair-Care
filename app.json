{
  "expo": {
    "name": "ChairCare",
    "slug": "chaircare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B111E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.offheman.chaircare",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B111E"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "16ef9b4c-b4bf-4233-98fd-a7e63c15deb1"
      }
    },
    "owner": "smruthijha"
  }
}
