# ==========================================
# ChairCare Backend — Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL
# Examples:
#   Local PostgreSQL (e.g. Docker or native):
#     DATABASE_URL="postgresql://postgres:your_password@localhost:5432/chaircare?sslmode=disable"
#   Cloud Managed PostgreSQL (Neon / Supabase / RDS):
#     DATABASE_URL="postgresql://username:password@ep-your-project-id.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/chaircare?sslmode=disable"

# JWT Authentication Secret (Use a strong random secret at least 32 characters long)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list of allowed frontend domains/IPs)
# Examples: http://localhost:8081,http://localhost:19006,https://yourdomain.com
CORS_ORIGIN=*

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=15

# Razorpay Payment Gateway Credentials (Optional)
# If left empty, backend automatically runs in safe Simulator/Sandbox mode.
# When ready for real payments, set PAYMENT_GATEWAY_ENV to 'production' or 'sandbox'
# and enter your Razorpay API Key ID and Secret.
PAYMENT_GATEWAY_ENV=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
