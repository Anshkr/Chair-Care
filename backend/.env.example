# ==========================================
# ChairCare Backend — Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@ep-your-project-id.region.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret (Use a strong 256-bit random string)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origin for Frontend Client (e.g. http://localhost:8081 for Expo Web)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=15

# Payment Provider Integration (Optional - Sandboxed/Mock mode enabled when not set)
PAYMENT_GATEWAY_ENV=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
