# ==========================================
# ChairCare Frontend — Environment Variables
# ==========================================

# Backend REST API Base URL
# Point this to your backend server endpoint.
# Local Development:
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
# Self-Hosted Server:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# Razorpay Payment Gateway Public Key ID (Client-side)
# Required for online prepaid checkout (leave blank to run in Simulator mode)
# Example: rzp_test_xxxxxxxxxxxx or rzp_live_xxxxxxxxxxxx
EXPO_PUBLIC_RAZORPAY_KEY_ID=
